#!/bin/bash
# Build and install Maprisma Settings (formerly Maprisma Manager) for this user (no sudo):
#
#   tools/install-local [--no-build]     build, stop the running copies, swap the bundle in, links, entry, icon
#   tools/install-local --stage <dir>    build into <dir> only (the self-update: nothing installed)
#   tools/install-local --integrate      links, desktop entry and icon for the installed bundle only
#
# ~/.local/lib/maprisma-settings          the Flutter bundle, with bin/maprisma-settings-core (the core CLI)
# ~/.local/bin/maprisma-settings{,-core}  links
# ~/.local/share/applications             com.maprisma.Settings.desktop; the icon under icons/hicolor
#
# The old names keep working: the bundle has maprisma-manager and bin/maprisma-manager-core{,-applet,
# -tray} as links to the new programs, ~/.local/bin has maprisma-manager{,-core,-applet,-tray} links
# to those, com.maprisma.Manager.desktop is a hidden entry that starts maprisma-settings, and the
# folders of the old name (~/.config, ~/.local/state, ~/.local/share, ~/.cache, ~/.local/lib) are
# renamed once and left as links to the new ones (procs.sh migrate_legacy). A Manager from before the
# rename updates itself into this build: its checks look for the old names, which the stage has.
#
# A running Flutter app maps its code from its bundle: never copy over it. The running copies are
# stopped (found by their real program path: the process name is cut to 15 characters, so pkill by
# name misses them), a fresh folder is swapped in by rename, and the app is not restarted.
#
# --stage <dir> is what Maprisma Settings runs to update itself: <dir> gets bundle/, tools/install-local,
# tools/self-update and packaging/; it checks it and its helper (tools/self-update) swaps
# it in once the app has quit, then runs <dir>/tools/install-local --integrate.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
lib="$HOME/.local/lib/maprisma-settings"
bin="$HOME/.local/bin"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
build=1 stage="" integrate=0
while (( $# )); do
  case "$1" in
    --no-build) build=0 ;;
    --stage) [[ $# -ge 2 && -n $2 ]] || { echo "--stage needs a folder" >&2; exit 2; }; stage=$2; shift ;;
    --integrate) integrate=1; build=0 ;;
    *) echo "usage: tools/install-local [--no-build] [--stage <dir>] [--integrate]" >&2; exit 2 ;;
  esac
  shift
done
export PATH="${FLUTTER:-/mnt/Data/flutter/bin}:$PATH"
bundle="$root/flutter_app/build/linux/x64/release/bundle"

# A desktop file's Exec value for a program path: quoted, escaped for the Exec rules and the
# desktop file value layer (Plasma's own PATH has no ~/.local/bin, so the full path).
exec_of() {
  local x=$1
  x=${x//\\/\\\\}; x=${x//\"/\\\"}; x=${x//\`/\\\`}; x=${x//\$/\\\$}
  x=${x//\\/\\\\}; x=${x//\%/%%}
  printf '"%s"' "$x"
}

# $1 (a packaging file) to $2 with its Exec= set to $3; Hidden=true of an existing $2 is kept
# (the Bar page took the icon out).
put_entry() {
  local hidden=0
  [[ -f $2 ]] && grep -qx 'Hidden=true' "$2" && hidden=1
  { grep -v '^Exec=' "$1"; printf 'Exec=%s\n' "$3"; if (( hidden )); then echo 'Hidden=true'; fi; } > "$2.tmp.$$"
  mv -f "$2.tmp.$$" "$2"
}

# The old names inside a bundle folder ($1): links to the new programs.
compat_links() {
  local f
  [[ -e $1/maprisma-settings ]] && ln -sfn maprisma-settings "$1/maprisma-manager"
  for f in core applet tray; do
    [[ -e $1/bin/maprisma-settings-$f ]] && ln -sfn "maprisma-settings-$f" "$1/bin/maprisma-manager-$f"
  done
  return 0
}

integrate() {
  local autostart="${XDG_CONFIG_HOME:-$HOME/.config}/autostart" icons="$data/icons/hicolor/scalable/apps" f old_tray
  mkdir -p "$bin" "$data/applications" "$icons" "$autostart"
  ln -sfn "$lib/maprisma-settings" "$bin/maprisma-settings"
  # the old name (the bundle's own link, so an older bundle put back by a rollback is found too)
  ln -sfn "$lib/maprisma-manager" "$bin/maprisma-manager"
  for f in core applet tray; do
    [[ -e $lib/bin/maprisma-settings-$f ]] && ln -sfn "$lib/bin/maprisma-settings-$f" "$bin/maprisma-settings-$f"
    [[ -e $lib/bin/maprisma-manager-$f ]] && ln -sfn "$lib/bin/maprisma-manager-$f" "$bin/maprisma-manager-$f"
  done
  put_entry "$root/packaging/com.maprisma.Settings.desktop" "$data/applications/com.maprisma.Settings.desktop" "$(exec_of "$bin/maprisma-settings")"
  # The old id: a hidden entry that starts Maprisma Settings (launchers, shortcuts and pins made
  # with com.maprisma.Manager); never with the Hidden=true of the old visible entry.
  rm -f -- "$data/applications/com.maprisma.Manager.desktop"
  put_entry "$root/packaging/com.maprisma.Manager.desktop" "$data/applications/com.maprisma.Manager.desktop" "$(exec_of "$bin/maprisma-settings")"
  for f in com.maprisma.Settings.svg com.maprisma.Manager.svg io.github.ubruckhaus.CosmicMaprismaManager-symbolic.svg; do
    [[ -f $root/packaging/$f ]] || continue
    install -m644 "$root/packaging/$f" "$icons/$f.tmp.$$"
    mv -f "$icons/$f.tmp.$$" "$icons/$f"
  done
  # The bar icon: COSMIC's applet entry, the tray's autostart (KDE, Maprisma Shell on Hyprland).
  if [[ -x $lib/bin/maprisma-settings-applet && -f $root/packaging/io.github.ubruckhaus.CosmicMaprismaManager.desktop ]]; then
    put_entry "$root/packaging/io.github.ubruckhaus.CosmicMaprismaManager.desktop" "$data/applications/io.github.ubruckhaus.CosmicMaprismaManager.desktop" "$(exec_of "$bin/maprisma-settings-applet")"
  fi
  # The tray's autostart of the old name gives way to the new one; a Hidden=true in it (the Bar
  # page took the icon out) goes with it.
  old_tray="$autostart/com.maprisma.Manager.Tray.desktop"
  if [[ -f $old_tray && ! -e $autostart/com.maprisma.Settings.Tray.desktop ]] && grep -qx 'Hidden=true' "$old_tray"; then
    printf '[Desktop Entry]\nHidden=true\n' > "$autostart/com.maprisma.Settings.Tray.desktop"
  fi
  if [[ -x $lib/bin/maprisma-settings-tray && -f $root/packaging/com.maprisma.Settings.Tray.desktop ]]; then
    put_entry "$root/packaging/com.maprisma.Settings.Tray.desktop" "$autostart/com.maprisma.Settings.Tray.desktop" "$(exec_of "$bin/maprisma-settings-tray")"
    rm -f -- "$old_tray"
    # The tray of the build before (still mapping the old files) makes way for this one.
    local ids
    ids=$(tray_ids)
    # shellcheck disable=SC2086
    [[ -n $ids ]] && { signal_ids TERM $ids; sleep 0.3; }
    if [[ ${XDG_CURRENT_DESKTOP:-} =~ (KDE|Hyprland) ]] && ! grep -qx 'Hidden=true' "$autostart/com.maprisma.Settings.Tray.desktop"; then
      # 9>&-: the install/self-update lock stays with us (the long-running tray would hold it).
      setsid -f "$bin/maprisma-settings-tray" >/dev/null 2>&1 < /dev/null 9>&- || true
    fi
  fi
  command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
  command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
}

if (( integrate )); then
  source "$root/tools/procs.sh"
  migrate_legacy
  [[ -x $lib/maprisma-settings ]] || { echo "no Maprisma Settings in $lib" >&2; exit 1; }
  integrate
  echo "Linked Maprisma Settings in $lib"
  exit 0
fi

if (( build )); then
  "$root/tools/gen-translations"
  # Flutter's asset step does not track the code: an incremental release build keeps the icon
  # font subset of an earlier build, so icons added since draw wrong or not at all. Start it fresh.
  rm -rf "$root/flutter_app/build/flutter_assets"
  (cd "$root/flutter_app" && flutter build linux --release >/dev/null)
  mkdir -p "$bundle/bin"
  rm -f -- "$bundle/maprisma-manager" "$bundle/bin/maprisma-manager-"*
  (cd "$root/packages/maprisma_manager_core" && dart compile exe bin/maprisma_manager_core.dart -o "$bundle/bin/maprisma-settings-core" >/dev/null)
  # The bar icon (COSMIC applet, tray): Rust; without cargo there is no bar icon.
  if command -v cargo >/dev/null; then
    (cd "$root/bar" && cargo build --release -q)
    install -m755 "$root/bar/target/release/maprisma-settings-applet" "$root/bar/target/release/maprisma-settings-tray" "$bundle/bin/"
  else
    echo "cargo is missing: no bar icon this time" >&2
  fi
fi
compat_links "$bundle"
for f in maprisma-settings lib/libapp.so data/flutter_assets/version.json bin/maprisma-settings-core maprisma-manager bin/maprisma-manager-core; do
  [[ -e $bundle/$f ]] || { echo "missing in the build: $f (run without --no-build)" >&2; exit 1; }
done

if [[ -n $stage ]]; then
  if [[ -e $stage ]] && [[ -n $(ls -A "$stage") ]]; then echo "$stage is not empty" >&2; exit 1; fi
  mkdir -p "$stage/bundle" "$stage/tools" "$stage/packaging"
  cp -a "$bundle/." "$stage/bundle/"
  install -m755 "$root/tools/install-local" "$root/tools/self-update" "$stage/tools/"
  install -m644 "$root/tools/procs.sh" "$stage/tools/"
  install -m644 "$root/packaging/"*.desktop "$root/packaging/"*.svg "$stage/packaging/"
  echo "Staged Maprisma Settings in $stage"
  exit 0
fi

# The helper of a self-update may be swapping right now: never at the same time. The folders of
# the old name first (the lock of an older helper is then the same file).
source "$root/tools/procs.sh"
migrate_legacy
if ! take_lock "$(xdg_dir XDG_STATE_HOME .local/state)/maprisma-settings/self-update"; then
  echo "a self-update of Maprisma Settings is in progress: try again when it has finished" >&2
  exit 1
fi

mkdir -p "$(dirname "$lib")"
new=$(mktemp -d "$lib.new.XXXXXX")
trap 'rm -rf -- "$new"' EXIT
cp -a "$bundle/." "$new/"
chmod 755 "$new"
stop_running 1
old=""
if [[ -e $lib ]]; then
  old=$(mktemp -d "$lib.old.XXXXXX"); rmdir "$old"
  mv -- "$lib" "$old" || { echo "could not move $lib aside: nothing changed" >&2; exit 1; }
fi
if ! mv -- "$new" "$lib"; then
  [[ -n $old ]] && mv -- "$old" "$lib"
  echo "could not put the new build in place: the old one is back" >&2
  exit 1
fi
trap - EXIT
[[ -n $old ]] && rm -rf -- "$old"
integrate
echo "Installed Maprisma Settings into $lib"
