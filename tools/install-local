#!/bin/bash
# Build and install Maprisma Manager for this user (no sudo):
#
#   tools/install-local [--no-build]     build, stop the running copies, swap the bundle in, links, entry, icon
#   tools/install-local --stage <dir>    build into <dir> only (the Manager's self-update: nothing installed)
#   tools/install-local --integrate      links, desktop entry and icon for the installed bundle only
#
# ~/.local/lib/maprisma-manager          the Flutter bundle, with bin/maprisma-manager-core (the core CLI)
# ~/.local/bin/maprisma-manager{,-core}  links
# ~/.local/share/applications            com.maprisma.Manager.desktop; the icon under icons/hicolor
#
# A running Flutter app maps its code from its bundle: never copy over it. The running copies are
# stopped (found by their real program path: the process name is cut to 15 characters, so pkill by
# name misses them), a fresh folder is swapped in by rename, and the app is not restarted.
#
# --stage <dir> is what the Manager runs to update itself: <dir> gets bundle/, tools/install-local,
# tools/self-update and packaging/; the Manager checks it and its helper (tools/self-update) swaps
# it in once the Manager has quit, then runs <dir>/tools/install-local --integrate.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
lib="$HOME/.local/lib/maprisma-manager"
bin="$HOME/.local/bin"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
build=1 stage="" integrate=0
while (( $# )); do
  case "$1" in
    --no-build) build=0 ;;
    --stage) [[ $# -ge 2 && -n $2 ]] || { echo "--stage needs a folder" >&2; exit 2; }; stage=$2; shift ;;
    --integrate) integrate=1; build=0 ;;
    *) echo "usage: tools/install-local [--no-build] [--stage <dir>] [--integrate]" >&2; exit 2 ;;
  esac
  shift
done
export PATH="${FLUTTER:-/mnt/Data/flutter/bin}:$PATH"
bundle="$root/flutter_app/build/linux/x64/release/bundle"

# A desktop file's Exec value for a program path: quoted, escaped for the Exec rules and the
# desktop file value layer (Plasma's own PATH has no ~/.local/bin, so the full path).
exec_of() {
  local x=$1
  x=${x//\\/\\\\}; x=${x//\"/\\\"}; x=${x//\`/\\\`}; x=${x//\$/\\\$}
  x=${x//\\/\\\\}; x=${x//\%/%%}
  printf '"%s"' "$x"
}

# $1 (a packaging file) to $2 with its Exec= set to $3; Hidden=true of an existing $2 is kept
# (the Bar page took the icon out).
put_entry() {
  local hidden=0
  [[ -f $2 ]] && grep -qx 'Hidden=true' "$2" && hidden=1
  { grep -v '^Exec=' "$1"; printf 'Exec=%s\n' "$3"; if (( hidden )); then echo 'Hidden=true'; fi; } > "$2.tmp.$$"
  mv -f "$2.tmp.$$" "$2"
}

integrate() {
  local autostart="${XDG_CONFIG_HOME:-$HOME/.config}/autostart" icons="$data/icons/hicolor/scalable/apps" f
  mkdir -p "$bin" "$data/applications" "$icons" "$autostart"
  ln -sfn "$lib/maprisma-manager" "$bin/maprisma-manager"
  for f in maprisma-manager-core maprisma-manager-applet maprisma-manager-tray; do
    [[ -e $lib/bin/$f ]] && ln -sfn "$lib/bin/$f" "$bin/$f"
  done
  put_entry "$root/packaging/com.maprisma.Manager.desktop" "$data/applications/com.maprisma.Manager.desktop" "$(exec_of "$bin/maprisma-manager")"
  for f in com.maprisma.Manager.svg io.github.ubruckhaus.CosmicMaprismaManager-symbolic.svg; do
    [[ -f $root/packaging/$f ]] || continue
    install -m644 "$root/packaging/$f" "$icons/$f.tmp.$$"
    mv -f "$icons/$f.tmp.$$" "$icons/$f"
  done
  # The bar icon: COSMIC's applet entry, the tray's autostart (KDE, Maprisma Shell on Hyprland).
  if [[ -x $lib/bin/maprisma-manager-applet && -f $root/packaging/io.github.ubruckhaus.CosmicMaprismaManager.desktop ]]; then
    put_entry "$root/packaging/io.github.ubruckhaus.CosmicMaprismaManager.desktop" "$data/applications/io.github.ubruckhaus.CosmicMaprismaManager.desktop" "$(exec_of "$bin/maprisma-manager-applet")"
  fi
  if [[ -x $lib/bin/maprisma-manager-tray && -f $root/packaging/com.maprisma.Manager.Tray.desktop ]]; then
    put_entry "$root/packaging/com.maprisma.Manager.Tray.desktop" "$autostart/com.maprisma.Manager.Tray.desktop" "$(exec_of "$bin/maprisma-manager-tray")"
    # The tray of the build before (still mapping the old files) makes way for this one.
    local ids
    ids=$(tray_ids)
    # shellcheck disable=SC2086
    [[ -n $ids ]] && { signal_ids TERM $ids; sleep 0.3; }
    if [[ ${XDG_CURRENT_DESKTOP:-} =~ (KDE|Hyprland) ]] && ! grep -qx 'Hidden=true' "$autostart/com.maprisma.Manager.Tray.desktop"; then
      # 9>&-: the install/self-update lock stays with us (the long-running tray would hold it).
      setsid -f "$bin/maprisma-manager-tray" >/dev/null 2>&1 < /dev/null 9>&- || true
    fi
  fi
  command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
  command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
}

if (( integrate )); then
  [[ -x $lib/maprisma-manager ]] || { echo "no Maprisma Manager in $lib" >&2; exit 1; }
  source "$root/tools/procs.sh"
  integrate
  echo "Linked Maprisma Manager in $lib"
  exit 0
fi

if (( build )); then
  "$root/tools/gen-translations"
  # Flutter's asset step does not track the code: an incremental release build keeps the icon
  # font subset of an earlier build, so icons added since draw wrong or not at all. Start it fresh.
  rm -rf "$root/flutter_app/build/flutter_assets"
  (cd "$root/flutter_app" && flutter build linux --release >/dev/null)
  mkdir -p "$bundle/bin"
  (cd "$root/packages/maprisma_manager_core" && dart compile exe bin/maprisma_manager_core.dart -o "$bundle/bin/maprisma-manager-core" >/dev/null)
  # The bar icon (COSMIC applet, tray): Rust; without cargo the Manager has no bar icon.
  if command -v cargo >/dev/null; then
    (cd "$root/bar" && cargo build --release -q)
    install -m755 "$root/bar/target/release/maprisma-manager-applet" "$root/bar/target/release/maprisma-manager-tray" "$bundle/bin/"
  else
    echo "cargo is missing: no bar icon this time" >&2
  fi
fi
for f in maprisma-manager lib/libapp.so data/flutter_assets/version.json bin/maprisma-manager-core; do
  [[ -e $bundle/$f ]] || { echo "missing in the build: $f (run without --no-build)" >&2; exit 1; }
done

if [[ -n $stage ]]; then
  if [[ -e $stage ]] && [[ -n $(ls -A "$stage") ]]; then echo "$stage is not empty" >&2; exit 1; fi
  mkdir -p "$stage/bundle" "$stage/tools" "$stage/packaging"
  cp -a "$bundle/." "$stage/bundle/"
  install -m755 "$root/tools/install-local" "$root/tools/self-update" "$stage/tools/"
  install -m644 "$root/tools/procs.sh" "$stage/tools/"
  install -m644 "$root/packaging/"*.desktop "$root/packaging/"*.svg "$stage/packaging/"
  echo "Staged Maprisma Manager in $stage"
  exit 0
fi

# The helper of a self-update may be swapping right now: never at the same time.
source "$root/tools/procs.sh"
if ! take_lock "${XDG_STATE_HOME:-$HOME/.local/state}/maprisma-manager/self-update"; then
  echo "a self-update of Maprisma Manager is in progress: try again when it has finished" >&2
  exit 1
fi

mkdir -p "$(dirname "$lib")"
new=$(mktemp -d "$lib.new.XXXXXX")
trap 'rm -rf -- "$new"' EXIT
cp -a "$bundle/." "$new/"
chmod 755 "$new"
stop_running 1
old=""
if [[ -e $lib ]]; then
  old=$(mktemp -d "$lib.old.XXXXXX"); rmdir "$old"
  mv -- "$lib" "$old" || { echo "could not move $lib aside: nothing changed" >&2; exit 1; }
fi
if ! mv -- "$new" "$lib"; then
  [[ -n $old ]] && mv -- "$old" "$lib"
  echo "could not put the new build in place: the old one is back" >&2
  exit 1
fi
trap - EXIT
[[ -n $old ]] && rm -rf -- "$old"
integrate
echo "Installed Maprisma Manager into $lib"
