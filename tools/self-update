#!/bin/bash
# The self-update helper of Maprisma Settings (formerly Maprisma Manager). The app copies it to
# ~/.local/state/maprisma-settings/self-update/helper and starts it detached (setsid) once a new
# build is staged and checked (docs/protocol.md "Self-update"):
#
#   helper --job <id> --stage <dir> --lib <bundle folder> --state <dir> [--proc /proc]
#          [--wait <pid>:<start> ...] --restart 0|1 [--ready-timeout 20] [--wait-timeout 600]
#
# 0. a Manager from before the rename passes the folders of the old name (--lib
#    ~/.local/lib/maprisma-manager, --state ~/.local/state/maprisma-manager/self-update): they are
#    renamed to maprisma-settings once and left as links (procs.sh migrate_legacy), and the bundle
#    is swapped in under the new name;
# 1. waits until every window it was told about (pid + start time) has quit;
# 2. swaps <stage>/bundle in by rename (the old bundle kept aside), keeps copies of the desktop
#    entry and icon, runs <stage>/tools/install-local --integrate (links, entry, icon);
# 3. --restart 1: starts the new app with MAPRISMA_MANAGER_READY=<state>/<job>.ready and waits
#    for that file (the app writes it after its first frame); --restart 0: the new core must answer
#    `version`;
# 4. ready: the old bundle goes; not ready in time: the new app is ended, the old bundle, entries
#    and icons come back and the old app is started again.
# The outcome goes to <state>/<job>.status (waiting|swapping|starting <pid>, then done,
# rolled back: …, failed: … or aborted: …) and, with --restart 1, to the core that is installed
# then (`maprisma-settings-core self-update-done <job> [--failed <why>]`, or maprisma-manager-core
# of an older bundle). It logs to <state>/<job>.log.
set -uo pipefail

job="" stage="" lib="" state="" proc=/proc restart=0 ready_timeout=20 wait_timeout=600
waits=()
while (( $# )); do
  case "$1" in
    --job) job=$2; shift ;;
    --stage) stage=$2; shift ;;
    --lib) lib=$2; shift ;;
    --state) state=$2; shift ;;
    --proc) proc=$2; shift ;;
    --wait) waits+=("$2"); shift ;;
    --restart) restart=$2; shift ;;
    --ready-timeout) ready_timeout=$2; shift ;;
    --wait-timeout) wait_timeout=$2; shift ;;
    *) echo "self-update: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
[[ -n $job && -n $stage && -n $lib && -n $state ]] || { echo "self-update: --job, --stage, --lib and --state are needed" >&2; exit 2; }
[[ $job =~ ^[0-9]{8}T[0-9]{6}Z-[a-z0-9]+-[a-z]+(-[0-9]+)?$ ]] || { echo "self-update: bad job id" >&2; exit 2; }
[[ $lib == /* && $stage == /* && $state == /* ]] || { echo "self-update: paths must be absolute" >&2; exit 2; }

log="$state/$job.log"
status_file="$state/$job.status"
ready="$state/$job.ready"
backup="$state/$job.backup"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
# The entries and icons install-local --integrate writes (both names): kept for a rollback, and the
# ones that weren't there before are removed by it.
autostart="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
kept_files=(
  "$data/applications/com.maprisma.Settings.desktop"
  "$data/applications/com.maprisma.Manager.desktop"
  "$data/icons/hicolor/scalable/apps/com.maprisma.Settings.svg"
  "$data/icons/hicolor/scalable/apps/com.maprisma.Manager.svg"
  "$autostart/com.maprisma.Settings.Tray.desktop"
  "$autostart/com.maprisma.Manager.Tray.desktop"
)
mkdir -p "$state"
exec >>"$log" 2>&1 </dev/null
say() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }
status() { printf '%s\n' "$1" > "$status_file.tmp" && mv -f "$status_file.tmp" "$status_file"; }
unset MAPRISMA_MANAGER_JOB

# The process helpers (the stage's copy: start_of, running_ids, signal_ids, stop_running, take_lock).
# shellcheck source=procs.sh
source "$stage/tools/procs.sh" || { status "failed: the stage has no procs.sh; nothing changed"; exit 1; }

# One self-update at a time, and never while install-local or uninstall-local run.
if ! take_lock "$state"; then
  say "another self-update, install-local or uninstall-local holds the lock: nothing changed"
  status "aborted: another install of Maprisma Settings is in progress; nothing changed"
  exit 1
fi

# The folders of the old name (an older Manager started this helper): renamed once, links left.
migrate_legacy
if [[ ${lib##*/} == maprisma-manager && ( -L $lib || ! -e $lib ) ]]; then
  lib="${lib%/*}/maprisma-settings"
  say "the bundle folder is $lib now (maprisma-manager is a link to it)"
fi

# The app and the core in a bundle: the new names, or the old ones of a bundle from before the rename.
gui_of() { if [[ -x $1/maprisma-settings ]]; then echo "$1/maprisma-settings"; else echo "$1/maprisma-manager"; fi; }
core_of() { if [[ -x $1/bin/maprisma-settings-core ]]; then echo "$1/bin/maprisma-settings-core"; else echo "$1/bin/maprisma-manager-core"; fi; }

# A process given as pid:start is gone when its /proc entry is missing, is another process (start
# time) or is a zombie.
alive() { [[ $(start_of "${1%%:*}") == "${1#*:}" ]]; }

core_done() {
  # the core that is installed now records the outcome in the job (receipt or failure); tried 3 times
  (( restart )) || return 0
  local core n
  core=$(core_of "$lib")
  [[ -x $core ]] || { say "no core at $core to record the outcome"; return 1; }
  for n in 1 2 3; do
    "$core" self-update-done "$job" "$@" && return 0
    say "self-update-done failed (try $n)"
    sleep 1
  done
  return 1
}

start_gui() {
  # $1: the ready file, or empty
  # 9>&-: the lock stays with the helper. The app would hold it for as long as it runs and
  # hand it on to everything its jobs start (a restarted shell, the launcher …), and no later
  # self-update or install-local could take it.
  if [[ -n ${1:-} ]]; then
    MAPRISMA_MANAGER_READY=$1 setsid -f "$(gui_of "$lib")" >/dev/null 2>&1 </dev/null 9>&-
  else
    setsid -f "$(gui_of "$lib")" >/dev/null 2>&1 </dev/null 9>&-
  fi
}

finish() { rm -rf -- "$stage" "$backup"; rm -f -- "$ready"; }

say "self-update $job: stage $stage, bundle $lib, restart $restart"
status "waiting $$"

# 1. the app quits
deadline=$(( SECONDS + wait_timeout ))
for w in "${waits[@]}"; do
  while alive "$w"; do
    if (( SECONDS >= deadline )); then
      say "Maprisma Settings (pid ${w%%:*}) didn't quit within $wait_timeout s: nothing changed"
      core_done --failed "Maprisma Settings didn't quit within $wait_timeout s; nothing changed"
      status "aborted: Maprisma Settings didn't quit within $wait_timeout s; nothing changed"
      finish
      exit 1
    fi
    sleep 0.2
  done
done
(( ${#waits[@]} )) && say "Maprisma Settings has quit"

fail_unchanged() {
  say "$1: nothing changed"
  core_done --failed "$1; nothing changed"
  status "failed: $1; nothing changed"
  finish
  exit 1
}

# 2. the swap (every rename checked; the old bundle stays until the new one is ready and recorded)
status "swapping $$"
[[ -x $stage/bundle/maprisma-settings && -x $stage/tools/install-local ]] || fail_unchanged "the stage is incomplete"
mkdir -p "$(dirname "$lib")" "$backup"
for f in "${kept_files[@]}"; do
  if [[ -f $f ]]; then cp -a -- "$f" "$backup/${f##*/}"; else : > "$backup/${f##*/}.absent"; fi
done
new=$(mktemp -d "$lib.new.XXXXXX") || fail_unchanged "no folder for the new bundle"
if ! cp -a "$stage/bundle/." "$new/"; then
  rm -rf -- "$new"
  fail_unchanged "copying the new bundle failed"
fi
chmod 755 "$new"
prev=""
if [[ -e $lib ]]; then
  prev=$(mktemp -d "$lib.old.XXXXXX") && rmdir "$prev" || { rm -rf -- "$new"; fail_unchanged "no name for the old bundle"; }
  mv -- "$lib" "$prev" || { rm -rf -- "$new"; fail_unchanged "the old bundle could not be moved aside"; }
fi
if ! mv -- "$new" "$lib"; then
  rm -rf -- "$new"
  if [[ -n $prev ]] && ! mv -- "$prev" "$lib"; then
    say "the old bundle could not be put back: it is at $prev"
    core_done --failed "the new bundle could not be put in place and the old one is at $prev"
    status "failed: the old bundle could not be put back; it is at $prev"
    exit 1
  fi
  fail_unchanged "the new bundle could not be put in place"
fi
say "swapped in (the old bundle is kept at ${prev:-nowhere: first install})"

rollback() {
  local why=$1 bad
  say "rolling back: $why"
  # the new build's processes (only the bundle itself: the old one is at $prev now)
  stop_running 0
  if [[ -z $prev ]]; then
    say "there is no earlier build to go back to: the new one stays"
    core_done --failed "$why (no earlier build to go back to)"
    status "failed: $why (no earlier build to go back to)"
    finish
    exit 1
  fi
  if [[ -e $lib ]]; then
    bad=$(mktemp -d "$lib.old.XXXXXX") && rmdir "$bad" && mv -- "$lib" "$bad" || {
      say "the new bundle could not be moved aside: the old one stays at $prev"
      core_done --failed "$why; the rollback failed, the old bundle is at $prev"
      status "failed: $why; the rollback failed, the old bundle is at $prev"
      exit 1
    }
  fi
  if ! mv -- "$prev" "$lib"; then
    say "the old bundle could not be put back: it is at $prev (the new one at ${bad:-?})"
    core_done --failed "$why; the rollback failed, the old bundle is at $prev"
    status "failed: $why; the rollback failed, the old bundle is at $prev"
    exit 1
  fi
  [[ -n ${bad:-} ]] && rm -rf -- "$bad"
  for f in "${kept_files[@]}"; do
    if [[ -f $backup/${f##*/} ]]; then
      cp -a -- "$backup/${f##*/}" "$f"
    elif [[ -f $backup/${f##*/}.absent ]]; then
      rm -f -- "$f"
    fi
  done
  command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1
  say "the old build is back"
  (( restart )) && start_gui ""
  core_done --failed "$why; the old build is back" || say "the outcome could not be recorded in the job"
  status "rolled back: $why"
  finish
  exit 1
}

# the links, desktop entry and icon: required
HOME=$HOME "$stage/tools/install-local" --integrate || rollback "linking the new build failed (install-local --integrate)"

# 3. the new build proves itself
if (( restart )); then
  status "starting $$"
  rm -f -- "$ready"
  start_gui "$ready"
  say "started the new Maprisma Settings; waiting $ready_timeout s for it to be ready"
  deadline=$(( SECONDS + ready_timeout ))
  until [[ -s $ready ]]; do
    (( SECONDS >= deadline )) && rollback "the new Maprisma Settings wasn't ready within $ready_timeout s"
    sleep 0.2
  done
  say "the new Maprisma Settings is ready (pid $(head -c 20 "$ready"))"
else
  if ! out=$("$(core_of "$lib")" version 2>&1) || [[ $out != maprisma-settings-core\ * && $out != maprisma-manager-core\ * ]]; then
    rollback "the new core doesn't start ($out)"
  fi
  say "the new core answers: $out"
fi

# 4. done: recorded first, then the old bundle goes (kept when the record failed)
if core_done; then
  [[ -n $prev ]] && rm -rf -- "$prev"
  status "done"
else
  say "the outcome could not be recorded in the job: the old bundle is kept at ${prev:-nowhere}"
  status "done: the outcome could not be recorded; the old bundle is kept at ${prev:-nowhere}"
fi
finish
say "done"
exit 0
