#!/usr/bin/env python3
"""Compile repository catalogs; run from any directory. No network or dependencies."""
import json
from pathlib import Path
root = Path(__file__).resolve().parent.parent
catalogs = {}
for code in ('en', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl'):
    base = json.loads((root / 'translations' / f'{code}.json').read_text())
    base.update(json.loads((root / 'translations/extra' / f'{code}.json').read_text()))
    if not all(isinstance(k, str) and isinstance(v, str) for k, v in base.items()):
        raise ValueError(f'{code}: catalog must map strings to strings')
    catalogs[code] = base
encoded = json.dumps(catalogs, ensure_ascii=False, indent=2).replace('$', r'\$')
(root / 'packages/maprisma_manager_core/lib/src/translations_generated.dart').write_text(
    '// Generated by tools/gen-translations. Do not edit.\n'
    'const catalogs = <String, Map<String, String>>' + encoded + ';\n')
