#!/bin/bash
# Remove Maprisma Manager for this user (the Manager doesn't remove itself):
#
#   tools/uninstall-local [--delete-settings]
#
# Stops the running copies (by their real program path), then deletes ~/.local/lib/maprisma-manager,
# the links ~/.local/bin/maprisma-manager{,-core}, the desktop entry and the icon. Its settings and
# state (~/.config/maprisma-manager, ~/.local/state/maprisma-manager: receipts, bar.json, job logs)
# stay unless --delete-settings is given. The apps it installed are not touched.
set -euo pipefail
lib="$HOME/.local/lib/maprisma-manager"
bin="$HOME/.local/bin"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
delete=0
for arg in "$@"; do
  case "$arg" in
    --delete-settings) delete=1 ;;
    *) echo "usage: tools/uninstall-local [--delete-settings]" >&2; exit 2 ;;
  esac
done
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/tools/procs.sh"
# Never while the self-update helper may be swapping (it would put the Manager back, or lose its rollback copy).
if ! take_lock "${XDG_STATE_HOME:-$HOME/.local/state}/maprisma-manager/self-update"; then
  echo "a self-update of Maprisma Manager is in progress: try again when it has finished" >&2
  exit 1
fi
stop_running 1
for l in "$bin/maprisma-manager" "$bin/maprisma-manager-core"; do
  # only our links (never a file someone put there)
  if [[ -L $l && $(readlink "$l") == "$lib/"* ]]; then rm -f -- "$l"; fi
done
rm -rf -- "$lib" "$lib".new.* "$lib".old.*
rm -f -- "$data/applications/com.maprisma.Manager.desktop" "$data/icons/hicolor/scalable/apps/com.maprisma.Manager.svg"
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
if (( delete )); then
  rm -rf -- "${XDG_CONFIG_HOME:-$HOME/.config}/maprisma-manager" "${XDG_STATE_HOME:-$HOME/.local/state}/maprisma-manager"
  echo "Removed Maprisma Manager and its settings"
else
  echo "Removed Maprisma Manager (its settings and state stay)"
fi
